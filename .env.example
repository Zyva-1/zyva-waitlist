# Postgres database for the waitlist (create an empty database first, e.g. "zyva_waitlist")
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/zyva_waitlist

# Public URL of this site (used in the confirmation email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email for the 6-digit codes. Use ONE of the two options below (SMTP wins if both are set).
# Sender shown to people, e.g.  Zyva <you@yourdomain.com>  (with Gmail it must be your Gmail address)
EMAIL_FROM=Zyva <you@yourdomain.com>

# Option A: SMTP (any mailbox). Gmail example: smtp.gmail.com, port 465, your address, and an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option B: Resend API key (needs a domain verified in Resend)
RESEND_API_KEY=

# Optional: social buttons (they go nowhere until set)
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TELEGRAM=

# Secret used to hash the 6-digit codes. Generate one with:  openssl rand -hex 32
WAITLIST_CODE_SECRET=
